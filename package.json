{
  "name": "bas-lending",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w @bas/backend\" \"npm run dev -w @bas/frontend\"",
    "dev:backend": "npm run dev -w @bas/backend",
    "dev:frontend": "npm run dev -w @bas/frontend",
    "test": "vitest run",
    "typecheck": "tsc -p backend && tsc -p frontend && tsc -p parity",
    "seed": "npm run seed -w @bas/backend --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "fast-check": "^3.23.2"
  }
}
