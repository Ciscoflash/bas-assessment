# Backend environment. Copy to .env and adjust. Real environment variables override this file.

# development | test | production
NODE_ENV=development

# Where the API listens
HOST=127.0.0.1
PORT=4000

# SQLite database file (relative to the backend folder), or :memory: for a throwaway DB
DB_PATH=./data/lending.db

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API directly.
# Not needed in dev: the frontend proxies /api through Vite.
CORS_ORIGINS=http://localhost:5173

# Business time zone in minutes from UTC (Lagos = 60). Only used for "today" in display statuses.
BUSINESS_UTC_OFFSET_MINUTES=60
