# Frontend environment. Copy to .env and adjust.
# Only VITE_-prefixed variables are exposed to the browser. Never put secrets here.

# Base URL the browser calls. "/api" goes through the Vite dev proxy below.
# For a separately hosted backend use an absolute URL, e.g. https://api.example.com/api
# (and add this frontend origin to the backend CORS_ORIGINS).
VITE_API_BASE_URL=/api

# Dev server only (read by vite.config.ts, not exposed to the browser)
FRONTEND_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:4000
